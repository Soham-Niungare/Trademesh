# Copy to .env.local for local development.
#
# Every value here is NEXT_PUBLIC_*, i.e. inlined into the client bundle at
# build time. That is correct for all of them -- they are just endpoint
# locations, not secrets. Nothing secret should ever be added to this file.
#
# These are OVERRIDES for split-port local development, where the frontend
# (:3000) and the backend (:8080) are two different origins to the browser.
# Leave them UNSET for a same-origin deployment -- one host serving both the
# app and the API, as the Kubernetes Ingress does -- so no environment
# hostname is ever compiled into the image. The container defaults live in
# frontend/Dockerfile as build ARGs, not here.
#
# Both URL vars additionally accept the literal value `same-origin`, which
# makes the app build its URLs against whatever origin served the page rather
# than a hostname fixed at build time. Use that, never an empty string: "" is
# falsy and would fall through to the localhost default in src/lib/config.ts.

# ORIGIN of the Spring Boot backend -- scheme://host:port only, no trailing
# slash and NO PATH PREFIX. The call sites in src/lib/api.ts already begin
# their paths with /api, so a value of "/api" here yields /api/api/... and a
# 403 from Spring Security.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# SockJS endpoint registered by the backend's WebSocketConfig ("/ws").
# NOTE: this is an http(s):// URL, not ws://. SockJS negotiates the actual
# transport (native WebSocket, xhr-streaming, ...) over HTTP itself.
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws

# Symbols the dashboard can switch between. The first is the default.
# The backend has no registered symbol list -- any string is a valid symbol
# and an unknown one simply returns an empty book -- so this is purely a
# frontend convenience list.
NEXT_PUBLIC_SYMBOLS=AAPL,MSFT,GOOG
